# Copy to .env and fill real values. .env is gitignored — never commit it.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/stride
# Separate DB pytest creates/migrates itself — never shared with the dev DB above.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/stride_test

# --- Auth: Google OAuth (backend is the confidential OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Auth: our own session tokens ---
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM (backend-side only) ---
LLM_API_KEY=

# --- Voice→text (added when the voice slice lands) ---
WHISPER_API_KEY=

# --- App ---
ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173
